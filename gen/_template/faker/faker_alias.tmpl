{{- /*gotype: github.com/ogen-go/ogen/gen/ir.Type*/ -}}
{{- define "faker/faker_alias" }}
// SetFake set fake values.
func (s *{{ $.Name }}) SetFake() {
	var unwrapped {{ $.AliasTo.Go }}
	{{- template "faker/faker" elem $.AliasTo "unwrapped" }}
	{{- if $.AliasEmbed }}
	*s = {{ $.Go }}{unwrapped}
	{{- else }}
	*s = {{ $.Go }}(unwrapped)
	{{- end }}
}
{{- end }}
